# --- Postgres / PostGIS ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=dc_india
PG_USER=dc
PG_PASSWORD=dc_dev_pw_change_me
PG_SCHEMA=dc_india

# --- Google Earth Engine ---
# Path to service account JSON (preferred for headless/CI).
# If empty, falls back to user `earthengine authenticate` credentials.
GEE_SERVICE_ACCOUNT_JSON=
# Your GCP project ID (NOT your email). The project must have Earth Engine enabled.
GEE_PROJECT=keen-philosophy-316716

# --- App ---
LOG_LEVEL=INFO
LOG_FORMAT=json
PIPELINE_CONFIG=configs/pipeline.yml
WEIGHTS_CONFIG=configs/weights/default.yml

# --- Overpass / OSM ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=180
OVERPASS_RATE_LIMIT_SEC=1.0

# --- FalkorDB (knowledge-graph projection) ---
# Redis-protocol; same host/port as a standard Redis. Postgres remains the
# source of truth; the graph is rebuildable via `dc graph rebuild`.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=dc_india
# Auto-project lineage + scoring nodes after each run. Disable for bulk
# backfills (then run `dc graph rebuild` once). Set to false if you don't
# need the graph layer at all (the Streamlit UI works without it).
FALKORDB_AUTO_SYNC=true
# Hard wall-clock budget (seconds) for the post-scoring graph sync.
# At 600 we surface a clean "graph sync timed out — run dc graph rebuild"
# warning instead of hanging the CLI indefinitely.
FALKORDB_SYNC_TIMEOUT_SECONDS=600
NASA_API_KEY=aejc3jEX1q8ChfdXIPcw3rSEtuLBQHS6CXDfTMdl