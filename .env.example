# --- Postgres / PostGIS ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=dc_india
PG_USER=dc
PG_PASSWORD=dc_dev_pw_change_me
PG_SCHEMA=dc_india

# --- Google Earth Engine ---
# Path to service account JSON (preferred for headless/CI).
# If empty, falls back to user `earthengine authenticate` credentials.
GEE_SERVICE_ACCOUNT_JSON=
# Your GCP project ID (NOT your email). The project must have Earth Engine enabled.
GEE_PROJECT=your-gcp-project-id

# --- App ---
LOG_LEVEL=INFO
LOG_FORMAT=json
PIPELINE_CONFIG=configs/pipeline.yml
WEIGHTS_CONFIG=configs/weights/default.yml

# --- Overpass / OSM ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=180
OVERPASS_RATE_LIMIT_SEC=1.0
